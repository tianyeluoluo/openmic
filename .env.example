# 复制为 .env 后填写真实密钥；不要提交 .env。
# LLM：OpenAI-compatible endpoint。以下示例使用 SiliconFlow。
OPENMIC_API_KEY=
OPENMIC_BASE_URL=https://api.siliconflow.cn/v1
OPENMIC_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 文本生成：baseline 或 cfunset。cfunset 需要先运行数据准备命令。
OPENMIC_CONTENT_MODE=baseline
OPENMIC_CFUNSET_INDEX=artifacts/cfunset/index.jsonl

# 也兼容已有项目常用命名：LLM_API_KEY / LLM_BASE_URL / LLM_MODEL。

# TTS：Key 留空时复用 OPENMIC_API_KEY；base URL 可与 LLM 不同。
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
TTS_FORMAT=wav
TTS_SAMPLE_RATE=16000
